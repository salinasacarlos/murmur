SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRjbGRqcWhldmRvcWxlY2d5aGRrIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NzMzNjA3NywiZXhwIjoyMDkyOTEyMDc3fQ.1m-DK-aRTHYtkmeVJDOJMzyyEXnGjgMxoWumfGYRxrQ
