# Si en Cursor .env.local se ve "apagado" respecto a .env.local.example:
# es porque .env.local está en .gitignore (correcto). La app sí lo usa en local.
#
# Copy to .env.local and fill from Supabase → Project Settings → API.
# Supported names (any one URL + one key combo works):
#
#   NEXT_PUBLIC_SUPABASE_URL  OR  SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  OR  NEXT_PUBLIC_SUPABASE_ANON_KEY  OR  SUPABASE_ANON_KEY

# Debe ser solo la raíz del proyecto (Settings → API → Project URL):
#   https://TU_REF.supabase.co
# Sin /rest/v1, sin /auth/v1 y sin barra al final.

NEXT_PUBLIC_SUPABASE_URL=https://tcldjqhevdoqlecgyhdk.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fPslvOKZ51CTHCrcvZmpSw_uVNVtRIo

# Email mostrado en footer (mailto). Fallback: hola@usemurmur.com
# NEXT_PUBLIC_SUPPORT_EMAIL=hola@usemurmur.com

# URL pública del sitio (sin barra final). Producción: https://joinmurmur.xyz
# Stripe Checkout success/cancel y metadataBase usan esto si no hay header Origin.
# En local puedes omitirlo o usar http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://joinmurmur.xyz

# Webhook Stripe y checkout (solo servidor; no uses NEXT_PUBLIC_*)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Precios recurrentes en modo subscription (Price ID de Stripe Dashboard)
# STRIPE_PRICE_PREMIUM_WEEKLY=price_...
# STRIPE_PRICE_PREMIUM_ANNUAL=price_...

# Service role: solo para rutas servidor que lo requieran (p. ej. webhook Stripe → actualizar profiles).
# Project Settings → API → service_role (no exponer al cliente).
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tras confirmar el correo (sign up), Supabase redirige aquí (emailRedirectTo).
# Debe figurar en Supabase → Authentication → Redirect URLs.
# Producción: https://joinmurmur.xyz/auth/login (y http://localhost:3000/auth/login para desarrollo).
# NEXT_PUBLIC_AUTH_CONFIRM_REDIRECT=https://joinmurmur.xyz/auth/login

# Alternative examples (optional — you only need one URL and one key):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
