# Si en Cursor .env.local se ve “apagado” respecto a .env.local.example:
# es porque .env.local está en .gitignore (correcto). La app sí lo usa en local.
#
# Copy to .env.local and fill from Supabase → Project Settings → API.
# Supported names (any one URL + one key combo works):
#
#   NEXT_PUBLIC_SUPABASE_URL  OR  SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  OR  NEXT_PUBLIC_SUPABASE_ANON_KEY  OR  SUPABASE_ANON_KEY

# Debe ser solo la raíz del proyecto (Settings → API → Project URL):
#   https://TU_REF.supabase.co
# Sin /rest/v1, sin /auth/v1 y sin barra al final.

NEXT_PUBLIC_SUPABASE_URL=https://tcldjqhevdoqlecgyhdk.supabase.co/rest/v1
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_fPslvOKZ51CTHCrcvZmpSw_uVNVtRIo

# Alternative examples (optional — you only need one URL and one key):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
